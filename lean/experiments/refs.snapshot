S4.trace: [{"kind":"stations","lat":51.5,"lon":-0.1},{"kind":"stations","lat":51.54,"lon":-0.1},{"kind":"lines","lat":51.5,"lon":-0.1},{"kind":"lines","lat":51.54,"lon":-0.1}]
S4.out: [{"startTs":1100,"endTs":1300,"wayName":"Ayton → Ceeford · Alpha Line","mode":"train","refinedMode":"train","refinedReason":"station-pair upgrade","refinedKinds":["gps-gap-inferred"],"pointCount":10}]


private def stubMatcher (fixes : Array MPt) (_ways : Array Way) : Option (Array MPt) :=
  match MATCHES.find? fun e => e.fixes == fixes with
  | some e => e.path
  | none => some MISS

private def ENV : Env := { drivableRoads := stubRoads, matcher := stubMatcher }


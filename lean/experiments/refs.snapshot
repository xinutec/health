### tofixed-refs.mts

=== ties round half-up on the magnitude ===
toFixed(0.5, 0) [0x3fe0000000000000] = "1"
toFixed(1.5, 0) [0x3ff8000000000000] = "2"
toFixed(2.5, 0) [0x4004000000000000] = "3"
toFixed(3.5, 0) [0x400c000000000000] = "4"
toFixed(-0.5, 0) [0xbfe0000000000000] = "-1"
toFixed(-1.5, 0) [0xbff8000000000000] = "-2"
toFixed(-2.5, 0) [0xc004000000000000] = "-3"
toFixed(0.25, 1) [0x3fd0000000000000] = "0.3"
toFixed(0.75, 1) [0x3fe8000000000000] = "0.8"
toFixed(0.125, 2) [0x3fc0000000000000] = "0.13"
toFixed(0.375, 2) [0x3fd8000000000000] = "0.38"

=== the exact binary value decides, not the decimal literal ===
toFixed(1.005, 2) [0x3ff0147ae147ae14] = "1.00"
toFixed(1.015, 2) [0x3ff03d70a3d70a3d] = "1.01"
toFixed(1.025, 2) [0x3ff0666666666666] = "1.02"
toFixed(8.575, 2) [0x4021266666666666] = "8.57"
toFixed(0.35, 1) [0x3fd6666666666666] = "0.3"
toFixed(0.45, 1) [0x3fdccccccccccccd] = "0.5"
toFixed(1.005, 2) [0x3ff0147ae147ae14] = "1.00"

=== padding and the f = 0 path ===
toFixed(0.5, 7) [0x3fe0000000000000] = "0.5000000"
toFixed(0.000001, 7) [0x3eb0c6f7a0b5ed8d] = "0.0000010"
toFixed(1e-8, 7) [0x3e45798ee2308c3a] = "0.0000000"
toFixed(0, 7) [0x0] = "0.0000000"
toFixed(-0, 7) [0x8000000000000000] = "0.0000000"
toFixed(123.456, 0) [0x405edd2f1a9fbe77] = "123"
toFixed(5e-7, 6) [0x3ea0c6f7a0b5ed8d] = "0.000000"
toFixed(9.9999999, 7) [0x4023fffffca501ad] = "9.9999999"
toFixed(9.99999995, 7) [0x4023fffffe5280d6] = "9.9999999"

=== negatives and carries ===
toFixed(-51.52, 7) [0xc049c28f5c28f5c3] = "-51.5200000"
toFixed(-0.13, 7) [0xbfc0a3d70a3d70a4] = "-0.1300000"
toFixed(99.99999999, 7) [0x4058fffffff54339] = "100.0000000"
toFixed(-99.99999999, 7) [0xc058fffffff54339] = "-100.0000000"
toFixed(0.9999999999, 7) [0x3feffffffff24190] = "1.0000000"

=== coordinate keys — the fusion identity ===
key(0,0) = 51.5200000,-0.1300000
key(0,250) = 51.5200000,-0.1263908
key(300,1000) = 51.5226949,-0.1155633
key(150,500) = 51.5213475,-0.1227817
key(0,1010) = 51.5200000,-0.1154189
fuse 1e-9 apart = 51.5200000 vs 51.5200000 same=true
split 2e-7 apart = 51.5200000 vs 51.5200002 same=false

=== other precisions used for display strings ===
toFixed(1234.56789, 1) [0x40934a4584f4c6e7] = "1234.6"
toFixed(-1234.56789, 1) [0xc0934a4584f4c6e7] = "-1234.6"
toFixed(1234.56789, 2) [0x40934a4584f4c6e7] = "1234.57"
toFixed(-1234.56789, 2) [0xc0934a4584f4c6e7] = "-1234.57"
toFixed(1234.56789, 3) [0x40934a4584f4c6e7] = "1234.568"
toFixed(-1234.56789, 3) [0xc0934a4584f4c6e7] = "-1234.568"
toFixed(0.05, 1) [0x3fa999999999999a] = "0.1"
toFixed(2.675, 2) [0x4005666666666666] = "2.67"

=== large and subnormal ===
toFixed(100000000000000000000, 7) [0x4415af1d78b58c40] = "100000000000000000000.0000000"
toFixed(123456789012345680000, 2) [0x441ac53a7e04bcda] = "123456789012345683968.00"
toFixed(5e-324, 7) [0x1] = "0.0000000"
toFixed(5e-324, 20) [0x1] = "0.00000000000000000000"
1e21 falls back to ToString = "1e+21"
Infinity = "Infinity"
-Infinity = "-Infinity"
NaN = "NaN"


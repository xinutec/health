  "Circle, Hammersmith & City and Metropolitan Lines" -> ["Circle Line","Hammersmith & City Line","Metropolitan Line"]
  "Circle and District Lines" -> ["Circle Line","District Line"]
  "Hammersmith & City Line" -> ["Hammersmith & City Line"]


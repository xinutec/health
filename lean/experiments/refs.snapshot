### share-refs.mts
=== buildShareUrl ===
buildShareUrl("https://h.example", "abc"): "https://h.example/share/abc"
buildShareUrl("https://h.example/", "abc"): "https://h.example/share/abc"
buildShareUrl("https://h.example//", "abc"): "https://h.example//share/abc"
buildShareUrl("https://h.example/sub", "tok-123"): "https://h.example/sub/share/tok-123"

=== shareableDateRange ===
shareableDateRange("2026-08-17", 1): {"from":"2026-08-17","to":"2026-08-17"}
shareableDateRange("2026-08-17", 7): {"from":"2026-08-11","to":"2026-08-17"}

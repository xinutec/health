### rail-journey-refs.mts

=== S1 THROUGH three fragments one line ===
in  5 seg(s), 12 fix(es)
  osm  stationsOnLine "Alpha Line"
out 1 seg(s)
  train/train [1000, 1720] "A → D · Alpha Line" pc=38 max=60
  reason "rail-journey assembly: 3 fragments on Alpha Line (GPS surfaced mid-ride) merged into one continuous ride"
  LEAN fixes S1 := #[⟨1000, 51.5, -0.1, 50.0⟩, ⟨1090, 51.5075, -0.1, 50.0⟩, ⟨1180, 51.515, -0.1, 50.0⟩, ⟨1270, 51.5225, -0.1, 50.0⟩, ⟨1360, 51.53, -0.1, 50.0⟩, ⟨1450, 51.5375, -0.1, 50.0⟩, ⟨1540, 51.545, -0.1, 50.0⟩, ⟨1630, 51.5525, -0.1, 50.0⟩, ⟨1720, 51.56, -0.1, 50.0⟩, ⟨1780, 51.5601, -0.1, 4.0⟩, ⟨1840, 51.5603, -0.1, 4.0⟩, ⟨1900, 51.5605, -0.1, 4.0⟩]
  LEAN out   S1 := #[(1000, 1720, "A → D · Alpha Line", 38, 60.0, "train", "train", "rail-journey assembly: 3 fragments on Alpha Line (GPS surfaced mid-ride) merged into one continuous ride")]
  LEAN trace S1 := #[.stations "Alpha Line"]

=== S2 INTERCHANGE no through line ===

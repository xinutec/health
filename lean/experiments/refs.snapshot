  LEAN out   S2 := #[(1000, 1200, "A → C · Alpha Line", 10, 60.0, "train", "train", ""), (1200, 1260, "", 4, 5.0, "walking", "walking", ""), (1260, 1460, "C → E · Beta Line", 10, 60.0, "train", "train", "")]
  LEAN trace S2 := #[.stations "Alpha Line", .stations "Beta Line"]


  osm  stationsOnLine "Alpha Line"
  osm  stationsOnLine "Beta Line"
out 3 seg(s)
  train/train [1000, 1200] "A → C · Alpha Line" pc=10 max=60
  walking/walking [1200, 1260] undefined pc=4 max=5
  train/train [1260, 1460] "C → E · Beta Line" pc=10 max=60

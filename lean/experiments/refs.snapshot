#guard (splitReversingLegs #[{ startTs := 1751000000, endTs := 1751000900, mode := "train", refinedMode := none, avgSpeed := 50.0, maxSpeed := 75.0, linearity := 0.9, pointCount := 7, refinedReason := none, refinedKinds := #[] }] SETTLE_150).map projSeg ==

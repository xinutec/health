   can still outweigh.
 * **time of day** — the stay's hour profile scored against the place's mined
   one, re-centred so a uniform (or un-mined `none`) profile scores exactly 0.
-  This separates co-located candidates a distance term cannot.
+  This separates co-located candidates a distance term cannot. The mined
+  profile is shrunk toward uniform by `HOUR_PROFILE_PSEUDO_DAYS` before it is
+  scored, so a place seen on two days is not certain about its hours
+  (2026-09-28; the guards below carry the values from that day, not the TS's).
 * **magnetic anchoring** — inside a place's magnet radius AND with positive
   biometric coherence, a boost proportional to its magnet strength.
 
@@ -71,6 +74,19 @@ def MAGNET_VETO_RELAX_MAX : Float := 2.0
 /-- Smoothing floor for the time-of-day term, so an hour absent from a
     place's profile takes a bounded penalty rather than `log 0`. -/
 def HOUR_PROFILE_EPS : Float := 0.02
+/-- Pseudo-days that shrink a place's mined hour profile toward uniform before
+    it is scored, so the term's weight grows with how often the place has been
+    seen. Same size as the venue prior's `HOUR_PSEUDO_VISITS`, for the same
+    reason: two visits are two samples of a 24-bin histogram.
+
+    ⚠ ADDED 2026-09-28 (#325, 06-24). The profile used to be scored as if it
+    were exact whatever its support. A place seen on TWO evenings therefore
+    scored +2.4 nats at 19:00 and a place seen on two mornings −1.1, a 3.5-nat
+    swing from four visits — enough to elect a cluster 77 m away (three place
+    radii, 1.7 σ) over one 20 m from a tight 21 m stay, and the stay was then
+    named from the wrong coordinate. Shrunk by 8 pseudo-days the same two
+    profiles score +1.1 and −0.15, and the geometry decides. -/
+def HOUR_PROFILE_PSEUDO_DAYS : Float := 8
 
 /-- One mined long-term cluster. -/
 structure PlaceCandidate where
@@ -98,14 +114,20 @@ def effectiveSigmaM (c : PlaceCandidate) : Float :=
     `Σ stay[h]·log(place[h]+ε)` re-centred by the uniform baseline, so a
     uniform — or `none` — place scores 0, concentration on the stay's hours
     scores positive, and avoidance scores negative. -/
-def hourProfileMatch (placeProfile : Option (List Float)) (stayProfile : List Float) : Float :=
+def hourProfileMatch (placeProfile : Option (List Float)) (stayProfile : List Float)
+    (days : Float) : Float :=
   match placeProfile with
   | none => 0
   | some pp =>
-    let uniformLog := Float.log (1 / Float.ofNat stayProfile.length + HOUR_PROFILE_EPS)
+    let bins := Float.ofNat stayProfile.length
+    let uniformLog := Float.log (1 / bins + HOUR_PROFILE_EPS)
+    -- Dirichlet shrinkage: `days` observations of the profile against
+    -- `HOUR_PROFILE_PSEUDO_DAYS` of uniform.
+    let shrunk := fun (p : Float) =>
+      (days * p + HOUR_PROFILE_PSEUDO_DAYS / bins) / (days + HOUR_PROFILE_PSEUDO_DAYS)
     let (raw, stayTotal) := stayProfile.zipIdx.foldl (fun (raw, tot) (w, h) =>
       if w == 0 then (raw, tot)
-      else (raw + w * Float.log (pp.getD h 0 + HOUR_PROFILE_EPS), tot + w)) (0, 0)
+      else (raw + w * Float.log (shrunk (pp.getD h 0) + HOUR_PROFILE_EPS), tot + w)) (0, 0)
     if stayTotal == 0 then 0 else raw - stayTotal * uniformLog
 
 /-- Magnet strength: bounded so Home does not drown out everything else. -/
@@ -138,7 +160,7 @@ def scorePlaceForSegment (c : PlaceCandidate) (segLat segLon : Float)
   let sigma := effectiveSigmaM c
   let logLikelihood := -(distM * distM) / (2 * sigma * sigma)
   let logPriorFreq := Float.log (c.uniqueDays + 1)
-  let logPriorTimeOfDay := hourProfileMatch c.hourProfile stayHourProfile
+  let logPriorTimeOfDay := hourProfileMatch c.hourProfile stayHourProfile c.uniqueDays
   let bs := biometricCoherence.getD 0
   let magnetBoost := if decide (distM ≤ magnetRadiusM c) then magnetStrength c * bs else 0
   logLikelihood + logPriorFreq + logPriorTimeOfDay + magnetBoost

+/-! ### `hourProfileMatch` — the weight of the hour term grows with visit-days -/
+
+-- 06-24's shape: a place seen on two evenings (2/3 at 18, 1/3 at 19) against
+-- an 18:00 stay. Unshrunk it scored +2.4; two days of evidence are worth ~1.1.
+private def TWO_EVENINGS : List Float := (List.range 24).map (fun h => if h == 18 then 2 / 3 else if h == 19 then 1 / 3 else 0)
+private def AT_18 : List Float := profile [18]
+#guard decide (0.9 < hourProfileMatch (some TWO_EVENINGS) AT_18 2 && hourProfileMatch (some TWO_EVENINGS) AT_18 2 < 1.3)
+-- More days, more weight — monotone in `days` and bounded by the unshrunk value.
+#guard decide (hourProfileMatch (some TWO_EVENINGS) AT_18 2 < hourProfileMatch (some TWO_EVENINGS) AT_18 20)
+#guard decide (hourProfileMatch (some TWO_EVENINGS) AT_18 20 < hourProfileMatch (some TWO_EVENINGS) AT_18 2000)
+#guard decide (hourProfileMatch (some TWO_EVENINGS) AT_18 2000 < 2.5)
+-- The two-morning neighbour at the same hour: a mild penalty, not −1.1.
+#guard decide (hourProfileMatch (some (profile [11])) AT_18 2 > -0.2)
+#guard decide (hourProfileMatch (some (profile [11])) AT_18 2 < 0)
+-- No days at all: the profile carries no weight and the term is 0.
+#guard hourProfileMatch (some TWO_EVENINGS) AT_18 0 == 0
+-- Uniform and `none` are still exactly 0 whatever the days.
+#guard hourProfileMatch (some UNIFORM) AT_18 50 == 0
+#guard hourProfileMatch none AT_18 50 == 0
+

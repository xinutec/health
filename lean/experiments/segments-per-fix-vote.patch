+/-- Share-of-total posterior of every mode in `MODES` order; all zero when the
+scores sum to zero (the window is then evidence of nothing). -/
+private def posteriors (scores : List ModeScore) : Array Float :=
+  let sum := scores.foldl (fun a s => a + s.score) 0
+  MODES.map fun m =>

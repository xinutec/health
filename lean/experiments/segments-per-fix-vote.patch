+/-- The segments of one same-mode run of fixes `[a, b)`.
+
+A stationary run is cut where a FIX is more than `STATIONARY_SPLIT_DIST_M` from
+the running mean of the fixes before it in its group — without that,
+"stationary at A, then stationary at B 280 m away" collapses into one stay. The
+cut is at fix resolution: a window straddling the move would put its centroid
+between the two places and cut a window early.
+
+Each group is described by the windows anchored inside it; a group too short to
+anchor a window (its fixes were voted by windows anchored before it) borrows the
+windows covering its first fix. -/
+private def splitRun (points : Array FilteredPoint) (windows : Array WindowFeatures)
+    (scores : Array (List ModeScore)) (a b : Nat) (mode : String) : Array TrackSegment := Id.run do
+  -- Group starts, as fix indices.
+  let mut starts : Array Nat := #[a]
+  if mode == "stationary" then
+    let mut cLat := 0.0
+    let mut cLon := 0.0
+    let mut cN : Nat := 0
+    for i in [a:b] do
+      let p := points.getD i default
+      if cN > 0 && haversineMeters cLat cLon p.lat p.lon > STATIONARY_SPLIT_DIST_M then
+        starts := starts.push i
+        cLat := p.lat; cLon := p.lon; cN := 1
+      else
+        -- Running mean: the divisor is the size AFTER the join.
+        cN := cN + 1
+        cLat := cLat + (p.lat - cLat) / Float.ofNat cN
+        cLon := cLon + (p.lon - cLon) / Float.ofNat cN
+  let bounds := starts.push b
+  let mut out : Array TrackSegment := #[]
+  for g in [0:bounds.size - 1] do
+    let fa := bounds.getD g a
+    let fb := bounds.getD (g + 1) b
+    if fb ≤ fa then continue
+    let anchored := (Array.range windows.size).filter fun w =>
+      let win := windows.getD w default
+      fa ≤ win.startIdx && win.startIdx < fb
+    let idx := if anchored.isEmpty then
+        (Array.range windows.size).filter fun w =>
+          let win := windows.getD w default
+          win.startIdx ≤ fa && fa < win.endIdx
+      else anchored
+    if idx.isEmpty then continue
+    let ws := idx.map fun w => windows.getD w default
+    let ss := idx.map fun w => scores.getD w []
+    out := out.push (segmentOf points ws ss fa fb mode)
+  return out
+
+/-- Segments from the per-fix vote: maximal runs of fixes that agree on a mode,
+each cut as `splitRun` says. A fix no window covers ends the run before it and
+belongs to no segment, as a lone fix in a too-short window did before. -/
+def segmentsByVote (points : Array FilteredPoint) (windows : Array WindowFeatures)
+    (scores : Array (List ModeScore)) : Array TrackSegment := Id.run do
+  let n := points.size
+  let modes := fixModes n windows scores
+  let mut out : Array TrackSegment := #[]
+  let mut runStart := 0
+  for i in [1:n + 1] do
+    let cur := modes.getD (i - 1) none
+    let next := if i < n then modes.getD i none else none
+    if next != cur || i == n then
+      match cur with
+      | some m => out := out ++ splitRun points windows scores runStart i (MODES.getD m "stationary")
+      | none => pure ()
+      runStart := i
+  return out
 

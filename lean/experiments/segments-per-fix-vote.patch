+private def fixModes (n : Nat) (windows : Array WindowFeatures) (scores : Array (List ModeScore)) :
+    Array (Option Nat) := Id.run do
+  let mut votes : Array (Array Float) := Array.replicate n (Array.replicate MODES.size 0.0)
+  let mut covered : Array Bool := Array.replicate n false
+  for hm_w : w in [0:windows.size] do

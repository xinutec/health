+windows was found or missed on `(time since the last gap) mod 300`. -/
+private def slidingWindows (points : Array FilteredPoint) (windowSec : Int) : Array WindowFeatures := Id.run do
+  let mut out : Array WindowFeatures := #[]
+  for hm_i : i in [0:points.size] do
+    let e := scanWindowEnd points (points[i].ts + windowSec) points.size i

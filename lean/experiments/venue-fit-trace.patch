+      | none => (0, 0, 0)
+    s!"\{\"n\":{l.name.quote},\"t\":{l.type.quote},\"st\":{l.subtype.quote},\"d\":{l.distanceM},\"of\":{of},\"enc\":{l.enclosing},\"rg\":{l.reverseGeocoded},\"b\":{b},\"dw\":{d},\"hr\":{h},\"sv\":{sv},\"tv\":{tv},\"k\":{k}}"
+  s!"VENUEFIT \{\"s\":{s.startUnix},\"e\":{s.endUnix},\"h\":{s.localHour},\"c\":[{String.intercalate "," c}]}"
+

+/-- VENUEFIT — one line per ranked stay with every candidate's RAW features,
+    for fitting the constants offline (#325). Dev instrument, never committed. -/
+private def venueFitLine (s : StayShape) (priors : Option VenuePriors) (pool : List Landmark) : String :=
+  let c := pool.map fun l =>
+    let (b, d, h) := match priors with
+      | some p => if PRIOR_TYPES.contains l.type then shapeParts l.subtype s p else (0, 0, 0)
+      | none => (0, 0, 0)
+    let of := match l.openFraction with | some f => toString f | none => "null"
+    -- The base rate's inputs too (subtype visits, total visits, kTypes), so a
+    -- pseudo-count can be swept offline.
+    let (sv, tv, k) := match priors with
+      | some p =>
+        let sv := match lookupStats p.bySubtype l.subtype with | some s => s.visits | none => 0

#!/usr/bin/env bash
# The runner is the hook. What to show on success, what exit 2 means, what a
# signal death left unjudged — the gate says each itself, so this only starts
# it. Through `scripts/dev`: the devshell is entered once here rather than on
# each of the table's rows, and `gate-commit.json` is the commit-time table.
set -euo pipefail
exec scripts/dev nix run "git+file:../dev-lint?ref=HEAD#gate" -- . gate-commit.json

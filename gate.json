        "run",
        "build"
      ],
      "cwd": "frontend",
      "env": {},
      "name": "frontend build",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "ui-check"
      ],
      "cwd": "frontend",
      "env": {},
      "name": "frontend ui-check (phone-width layout harness)",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD",
        "--",
        "--baseline",
        ".dev-lint-baseline",
        "."
      ],
      "cwd": ".",
      "env": {},
      "name": "dev-lint (baselined)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "build",
        "--no-warn-dirty",
        "--no-link",
        ".#verified-cli"
      ],
      "cwd": ".",
      "env": {},
      "name": "the verified CLI packages (what the production image consumes)",
      "timeout_s": 3600
    },
    {
      "argv": [
        "nix",
        "run",
        "../dev-lint#gate",
        "--",
        "--check-table",
        "gate.dhall",
        "gate.json"
      ],
      "cwd": ".",
      "env": {},
      "name": "the table matches its Dhall",
      "timeout_s": 300
    }

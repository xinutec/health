        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "install",
        "--frozen-lockfile"
      ],
      "cwd": ".",
      "env": {},
      "name": "backend deps match the lockfile",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "install",
        "--frozen-lockfile"

{
  "checks": [
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "install",
        "--frozen-lockfile"
      ],
      "cwd": "frontend",
      "env": {},
      "name": "frontend deps match the lockfile",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "typecheck:frontend"
      ],
      "cwd": ".",
      "env": {},
      "name": "typecheck (frontend app + e2e)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "-p",
        "backend",
        "--test",
        "frontend_unions"
      ],
      "cwd": ".",
      "env": {},
      "name": "frontend union copies match the backend",
      "timeout_s": 600
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "fmt",
        "--all",
        "--check",
        "--manifest-path",
        "rust/Cargo.toml"
      ],
      "cwd": ".",
      "env": {},
      "name": "rust formatting",
      "timeout_s": 180
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "scripts/rust-host-check.sh"
      ],
      "cwd": ".",
      "env": {},
      "name": "the in-process Rust host agrees with the spawned CLI",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/Cargo.toml",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "cwd": ".",
      "env": {
        "CARGO_TARGET_DIR": "/Users/pippijn/.cache/cargo/clippy-target"
      },
      "name": "clippy",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "nextest",
        "run",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace"
      ],
      "cwd": ".",
      "env": {},
      "name": "rust workspace tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "test",
        "--doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace"
      ],
      "cwd": ".",
      "env": {},
      "name": "rust doctests",
      "timeout_s": 600
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "lint:frontend"
      ],
      "cwd": ".",
      "env": {},
      "name": "lint (eslint, frontend)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "test:frontend"
      ],
      "cwd": ".",
      "env": {
        "NG_BUILD_MAX_WORKERS": "1"
      },
      "name": "frontend unit tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "lean-check"
      ],
      "cwd": ".",
      "env": {},
      "name": "Lean verified core + decode parity",
      "timeout_s": 3600
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "nix",
        "run",
        "../../dev-lint#ng-build",
        "--",
        "--expect",
        "dist/frontend/browser",
        "--",
        "pnpm",
        "run",
        "build"
      ],
      "cwd": "frontend",
      "env": {},
      "name": "frontend build",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "ui-check"
      ],
      "cwd": "frontend",
      "env": {},
      "name": "frontend ui-check (phone-width layout harness)",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD",
        "--",
        "--baseline",
        ".dev-lint-baseline",
        "."
      ],
      "cwd": ".",
      "env": {},
      "name": "dev-lint (baselined)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "build",
        "--no-warn-dirty",
        "--no-link",
        ".#verified-cli",
        ".#health-bins"
      ],
      "cwd": ".",
      "env": {},
      "name": "the verified CLI packages (what the production image consumes)",
      "timeout_s": 3600
    },
    {
      "argv": [
        "nix",
        "run",
        "../dev-lint#gate",
        "--",
        "--check-table",
        "gate.dhall",
        "gate.json"
      ],
      "cwd": ".",
      "env": {},
      "name": "the table matches its Dhall",
      "timeout_s": 300
    }
  ],
  "name": "health"
}

{
  "name": "health-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "sync": "node dist/sync.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "cd frontend && pnpm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc -p lean/tsconfig.experiments.json",
    "typecheck:frontend": "cd frontend && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "check:schema-types": "node scripts/check-schema-types.mjs",
    "check:frontend-unions": "node scripts/check-frontend-unions.mjs",
    "lint": "biome check .",
    "lint:frontend": "cd frontend && pnpm run lint",
    "format": "biome check --write .",
    "verify": "nix run ../dev-lint#gate -- . gate.json",
    "analyze": "node dist/cli/analyze-day.js",
    "audit:fitbit": "node dist/cli/audit-fitbit-sync.js",
    "golden": "scripts/golden.sh",
    "day-gate": "scripts/day-gate.sh",
    "focus-gate": "scripts/focus-gate.sh",
    "score-venues": "scripts/score-venues.sh",
    "golden-hsmm": "scripts/golden-hsmm.sh",
    "score-decoder": "scripts/score-decoder.sh",
    "score-constraints": "scripts/score-constraints.sh",
    "walk-gate": "scripts/walk-gate.sh",
    "capture-golden": "scripts/capture-golden.sh",
    "backtest": "scripts/backtest.sh",
    "lean-check": "scripts/lean-check.sh",
    "lean-shadow": "scripts/lean-shadow.sh",
    "compare-rail": "scripts/compare-rail.sh",
    "compare-geo": "scripts/compare-geo.sh",
    "compare-match": "scripts/compare-match.sh",
    "compare-stationchain": "scripts/compare-stationchain.sh",
    "compare-kalman": "scripts/compare-kalman.sh",
    "compare-gpsquality": "scripts/compare-gpsquality.sh",
    "bench-bridge": "scripts/bench-bridge.sh",
    "render-match-compare": "node dist/cli/render-match-compare.js",
    "shadow-passes": "node dist/cli/shadow-passes.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "kysely": "^0.29.0",
    "kysely-mariadb": "^0.1.2",
    "mariadb": "^3.4.0",
    "stream-chain": "^3.6.2",
    "stream-json": "^2.1.0",
    "tz-lookup": "^6.1.25",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}

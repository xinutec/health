{
  "name": "health-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "test:frontend": "cd frontend && pnpm test",
    "typecheck:frontend": "cd frontend && pnpm exec tsc --noEmit -p tsconfig.app.json && pnpm exec tsc --noEmit -p tsconfig.e2e.json",
    "lint:frontend": "cd frontend && pnpm run lint",
    "verify": "scripts/dev nix run ../dev-lint#gate -- . gate-commit.json",
    "lean-check": "scripts/lean-check.sh",
    "verify:deploy": "scripts/dev nix run ../dev-lint#gate -- . gate.json"
  }
}
